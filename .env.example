# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

ADZUNA_APP_ID=
ADZUNA_APP_KEY=

CAREERJET_AFFID=

# Optional: free key from himalayas.app/api-keys (works without one, on a shared allowance)
HIMALAYAS_API_KEY=

# Microsoft Outlook — see docs/outlook-setup.md for how to get your own client ID
OUTLOOK_CLIENT_ID=

# Azure Postgres shadow copy of jobs.db (docs/postgres-mirror.md); only read when
# settings.yaml has database.postgres_mirror: true, or by scripts/pg_mirror.py
JOBSEARCH_PG_URL=

# Snowflake copy of the job data (docs/snowflake-guide.md). Leave JOBSEARCH_BLOB_URL empty to
# turn the daily Snowflake step off.
JOBSEARCH_BLOB_URL=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_PRIVATE_KEY_PATH=
