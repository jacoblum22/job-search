# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.env
.venv
env/
venv/

# Conda
.conda/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Playwright (fallback — not actively used)
playwright-report/
test-results/

# Misc
*.log
logs/
.cache/

# Aggregator — generated output, regenerated on every run
jobs.db
# SQLite copies of the main database (docs/postgres-mirror.md)
backups/
dashboard.html
export.xlsx
.aggregate.lock

# Gmail OAuth — per-person, never shared/committed
credentials.json
token.json

# Outlook OAuth — per-person, never shared/committed
token_outlook.json

# Snowflake login key (docs/snowflake-guide.md)
*.p8

# Downloaded Google OAuth client secret — never commit
client_secret_*.json

# Personal application materials (resumes, cover letters, vault, screening answers) — never commit, repo is public
materials/

# Personal contact details for cover letter headers — never commit
config/contact.yaml

# Claude Code: personal permission approvals; Chrome task scratch files
.claude/settings.local.json
.browser-queue/

# Power BI report (docs/power-bi-guide.md): the saved data copy and per-PC settings stay local.
# cache.abf holds every imported row, application outcomes included; the repo is public.
powerbi/**/.pbi/cache.abf
powerbi/**/.pbi/localSettings.json
# A .pbix is one binary file with every imported row inside; only the .pbip text files go in git.
*.pbix
