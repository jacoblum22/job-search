table fct_applications
	lineageTag: 74648575-7ba1-4cce-b0c6-7c97d98e85f7

	measure Packets = COUNTROWS(fct_applications)
		formatString: 0
		lineageTag: 384dd9c6-e6b5-4b61-ab00-52b51b86abdc

	measure Applied = CALCULATE([Packets], fct_applications[reached_applied] = TRUE())
		formatString: 0
		lineageTag: 43566a60-a964-4d8a-9883-f8daf12d5ca9

	measure Callbacks = CALCULATE([Packets], fct_applications[reached_callback] = TRUE())
		formatString: 0
		lineageTag: d51532b6-98b2-4444-a644-fc62e7bb6d96

	measure Interviews = CALCULATE([Packets], fct_applications[reached_interview] = TRUE())
		formatString: 0
		lineageTag: 51a0b72e-c680-4cf0-89d5-4b3cd55673e3

	measure 'Callback rate' = DIVIDE([Callbacks], [Applied])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 23fb77ce-9a55-4f12-99d8-3f97a585f09a

	measure Approved = CALCULATE([Packets], fct_applications[reached_approved] = TRUE())
		formatString: 0
		lineageTag: 151b0045-1940-437a-be73-bd1a0b479a18

