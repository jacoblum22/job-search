table fct_postings
	lineageTag: 0fe27e7d-506a-4eda-858c-62921e16b941

	measure 'Open postings' = COUNTROWS(fct_postings)
		formatString: #,0
		lineageTag: 0488ea84-5e20-40b8-958d-7c4496aeb588

	measure 'A/B postings' = CALCULATE([Open postings], KEEPFILTERS(fct_postings[tier] IN {"A", "B"}))
		formatString: 0
		lineageTag: 813360a9-12e4-4598-82bf-57b761a785e5

	measure 'A/B share' = DIVIDE([A/B postings], [Open postings])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 1ab78d14-6abf-415b-b0da-9a700f57f348

